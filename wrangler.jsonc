{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chess-arena-online",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./dist",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "ChessRoom"
      },
      {
        "name": "LOBBY",
        "class_name": "LobbyRegistry"
      }
    ]
  },
  "exports": {
    "ChessRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "LobbyRegistry": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173"
  },
  "env": {
    // Production fails closed to same-origin only; add an explicit cross-origin
    // frontend here if one is ever deployed.
    "production": {
      "vars": {
        "ALLOWED_ORIGINS": ""
      }
    }
  },
}
